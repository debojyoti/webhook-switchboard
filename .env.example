# Runtime
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/switchboard
PUBLIC_BASE_URL=http://localhost:3000

# Single-admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Base64-encoded 32-byte key used for AES-256-GCM encryption.
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Webhook safety and retention
ALLOW_INTERNAL_ROUTE_TARGETS=false
EVENT_RETENTION_DAYS=30
DELIVERY_RETENTION_DAYS=30
EVENT_BODY_RETENTION_DAYS=30
MAX_WEBHOOK_BODY_BYTES=5242880
